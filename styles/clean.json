{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Clean",
	"settings": {
		"color": {
			"palette": [
				{ "slug": "white", "color": "#ffffff", "name": "White" },
				{ "slug": "surface", "color": "#fafafa", "name": "Surface" },
				{ "slug": "border", "color": "#eceef1", "name": "Border" },
				{ "slug": "text", "color": "#14161a", "name": "Text" },
				{ "slug": "muted", "color": "#5b6068", "name": "Muted" },
				{ "slug": "primary", "color": "#4338ca", "name": "Primary" },
				{ "slug": "secondary", "color": "#0f766e", "name": "Secondary" },
				{ "slug": "accent", "color": "#b45309", "name": "Accent" }
			],
			"gradients": [
				{
					"slug": "primary-to-secondary",
					"gradient": "linear-gradient(135deg, #4338ca 0%, #0f766e 100%)",
					"name": "Primary to Secondary"
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--white)",
			"text": "var(--wp--preset--color--text)"
		},
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--primary)" },
				":hover": {
					"color": { "text": "var(--wp--preset--color--secondary)" }
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "var(--wp--preset--color--white)"
				},
				"border": { "radius": "999px" },
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--text)",
						"text": "var(--wp--preset--color--white)"
					}
				}
			}
		}
	}
}

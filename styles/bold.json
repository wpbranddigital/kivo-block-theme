{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Bold",
	"settings": {
		"color": {
			"palette": [
				{ "slug": "white", "color": "#ffffff", "name": "White" },
				{ "slug": "surface", "color": "#f4f4f6", "name": "Surface" },
				{ "slug": "border", "color": "#e0e0e6", "name": "Border" },
				{ "slug": "text", "color": "#0a0a0f", "name": "Text" },
				{ "slug": "muted", "color": "#55565f", "name": "Muted" },
				{ "slug": "primary", "color": "#e11d48", "name": "Primary" },
				{ "slug": "secondary", "color": "#0e7490", "name": "Secondary" },
				{ "slug": "accent", "color": "#a16207", "name": "Accent" }
			],
			"gradients": [
				{
					"slug": "primary-to-secondary",
					"gradient": "linear-gradient(135deg, #e11d48 0%, #0e7490 100%)",
					"name": "Primary to Secondary"
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--white)",
			"text": "var(--wp--preset--color--text)"
		},
		"typography": {
			"fontWeight": "500"
		},
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--primary)" },
				":hover": {
					"color": { "text": "var(--wp--preset--color--secondary)" }
				}
			},
			"heading": {
				"typography": { "fontWeight": "800" }
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "var(--wp--preset--color--white)"
				},
				"border": { "radius": "0.25rem" },
				"typography": {
					"fontWeight": "700",
					"textTransform": "uppercase",
					"letterSpacing": "0.03em"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--text)",
						"text": "var(--wp--preset--color--white)"
					}
				}
			}
		}
	}
}
